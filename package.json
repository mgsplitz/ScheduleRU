{
  "name": "scheduleru",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "test": "npm run test:data && npm run test:legacy",
    "test:data": "node --test packages/catalog/test/*.test.ts tools/catalog/test/*.test.ts packages/reference-data/test/*.test.ts tools/reference-data/test/*.test.ts",
    "test:catalog": "node --test packages/catalog/test/*.test.ts tools/catalog/test/*.test.ts",
    "test:legacy": "node --test worker/tests/*.test.mjs",
    "typecheck": "tsc -b packages/catalog packages/reference-data tools/catalog tools/reference-data",
    "catalog": "node tools/catalog/src/cli.ts",
    "reference-data": "node tools/reference-data/src/cli.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.117.0"
  }
}
